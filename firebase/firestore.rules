rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Admin gate: presence of /admins/{uid}.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(uid()));
    }

    function isPassenger() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(uid())).data.role == 'passenger';
    }

    function isDriver() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/drivers/$(uid())).data.role == 'driver';
    }

    function allowedCity(city) {
      return city in ['asyut', 'sohag', 'qena'];
    }

    match /admins/{adminId} {
      allow read: if isAdmin() && adminId == uid();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && userId == uid());
      allow create: if isSignedIn() && userId == uid();
      allow update: if isAdmin() || (isSignedIn() && userId == uid());
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || (isSignedIn() && driverId == uid());
      allow create: if isSignedIn() && driverId == uid();
      allow update: if isAdmin() || (isSignedIn() && driverId == uid());
      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      function isTripPassenger() {
        return isSignedIn() && resource.data.passengerId == uid();
      }

      function isTripDriver() {
        return isSignedIn() && resource.data.driverId == uid();
      }

      function canReadTrip() {
        return isAdmin() || isTripPassenger() || isTripDriver();
      }

      allow get, list: if canReadTrip();

      allow create: if isPassenger()
        && request.resource.data.passengerId == uid()
        && allowedCity(request.resource.data.city)
        && request.resource.data.status == 'searching';

      // Status transitions are enforced authoritatively in Cloud Functions,
      // but we apply a best-effort client rule here.
      allow update: if canReadTrip()
        && request.resource.data.city == resource.data.city
        && request.resource.data.passengerId == resource.data.passengerId
        && request.resource.data.driverId == resource.data.driverId;

      allow delete: if isAdmin();
    }

    match /wallets/{driverId} {
      allow read: if isAdmin() || (isDriver() && driverId == uid());
      allow write: if isAdmin(); // Only Functions/Admin should write balances/ledgers
    }

    match /chats/{tripId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    match /sos/{tripId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promos/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

